{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-graph.invalid/operation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_id", "request_hash", "action", "base", "preconditions", "node_ids", "resolved_at", "generated_ids", "changed_hashes"],
  "properties": {
    "schema": {"const": 1},
    "operation_id": {"$ref": "#/$defs/uuid"},
    "request_hash": {"$ref": "#/$defs/hash"},
    "action": {"enum": ["create", "update", "apply", "supersede", "link", "unlink", "repair", "revert"]},
    "base": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "preconditions": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(\\.md)?$",
        "not": {"pattern": "[\\r\\n]"}
      },
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "node_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}},
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "generated_ids": {
      "type": "object",
      "maxProperties": 2,
      "propertyNames": {"enum": ["create", "replacement"]},
      "additionalProperties": {"$ref": "#/$defs/uuid"}
    },
    "changed_hashes": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": {
        "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.md|quarantine/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.md)$",
        "not": {"pattern": "[\\r\\n]"}
      },
      "additionalProperties": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
    },
    "target_operation": {"$ref": "#/$defs/uuid"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "revert"}}},
      "then": {"required": ["target_operation"]},
      "else": {"not": {"required": ["target_operation"]}}
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
  }
}
