{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-graph.invalid/store.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id"],
  "properties": {
    "schema": {"const": 1},
    "id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
